0164                  static int dsk_rd16(int drive, uint32_t off, uint16_t *w) {
0165                      FILE *f = rkdrv[drive].f;
0166                      fseek(f, (long)off, SEEK_SET);
0167                      int lo = fgetc(f), hi = fgetc(f);
0168                      if (lo == EOF) lo = 0;
0169                      if (hi == EOF) hi = 0;
0170                      *w = (uint16_t)(lo | (hi << 8));
0171                      return 0;
0172                  }
0173                  static int dsk_wr16(int drive, uint32_t off, uint16_t w) {
0174                      FILE *f = rkdrv[drive].f;
0175                      fseek(f, (long)off, SEEK_SET);
0176                      fputc(w & 0377, f);
0177                      fputc((w >> 8) & 0377, f);
0178                      return 0;
0179                  }
