0049                  static uint8_t *ov_find(uint32_t blk) {
0050                      for (int i = 0; i < ov_n; i++)
0051                          if (ov_blk[i] == blk) return ov_data[i];
0052                      return 0;
0053                  }
0054                  static uint8_t *ov_alloc(uint32_t blk, FILE *f) {
0055                      if (ov_n >= ov_max) return 0;
0056                      ov_blk[ov_n] = (uint16_t)blk;
0057                  #ifndef PDP11_NOFILE
0058                      fseek(f, (long)blk * 512, SEEK_SET);
0059                      size_t got = fread(ov_data[ov_n], 1, 512, f);
0060                      if (got < 512) memset(ov_data[ov_n] + got, 0, 512 - got);
0061                  #else
0062                      (void)f;
0063                      memset(ov_data[ov_n], 0, 512);
0064                  #endif
0065                      if (++ov_n > ov_peak) ov_peak = ov_n;
0066                      return ov_data[ov_n - 1];
0067                  }
