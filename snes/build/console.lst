0022
0023                  #define COLS 32
0024                  #define ROWS 28                 /* visible; ring is 32 */
0025                  #define RING 32
0026                  #define MAP_VRAM 0x4000         /* word address */
0027
0028                  static uint8_t shadow[RING][COLS];
