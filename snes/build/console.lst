0001                  /* Text console: 64 cols x 28 rows, Mode 5 hires, hardware-scroll ring.
0002                   * Own module — keyboard/ and basic-rom/ stay untouched.
0003                   *
0004                   * Mode 5 is 512-dot hires: each tilemap cell is 16px wide and fetches an 8x8
0005                   * tile PAIR (N, N+1). We split each cell into two text columns using two
0006                   * layers, the emu8086/dosboot.asm technique (see snes/tools notes):
0007                   *   - BG2 (2bpp) holds EVEN text columns: font tile pair = [glyph][blank]
0008                   *   - BG1 (4bpp) holds ODD  text columns: font tile pair = [blank][glyph]
0009                   * transparency + priority composite them, giving 64 readable 8px columns.
0010                   *
0011                   * Tilemaps (32x32 each): BG2 at word $0000, BG1 at word $0400. Row r -> +r*32.
0012                   * A map entry for char c = (2c) | $2000(priority); it fetches tiles 2c,2c+1.
0013                   * Fonts: BG2 chars at $1000 (2bpp), BG1 chars at $3000 (4bpp); both build
0014                   * their [glyph][blank]/[blank][glyph] pairs from font8x8_basic. Color 1 =
0015                   * green, shared via CGRAM[1] by both bit depths.
0016                   *
0017                   * The 32-row map is a ring: scroll bumps BG1/BG2 VOFS by 8 and clears the
0018                   * wrapped row, so a scroll dirties one row, not 28.
0019                   */
0020                  #include <stdint.h>
0021                  #include "console.h"
0022                  #include "font8x8_basic.h"
0023
0024                  #define R8(a) (*(volatile uint8_t *)(a))
0025
0026                  #define COLS 64
0027                  #define ROWS 28
0028                  #define RING 32
0029                  #define BG2_MAP 0x0000
0030                  #define BG1_MAP 0x0400
0031                  #define BG2_CHR 0x1000          /* 2bpp: 8 words/tile */
0032                  #define BG1_CHR 0x3000          /* 4bpp: 16 words/tile */
0033
0034                  static uint8_t shadow[RING][COLS];
    \ 000000                      .section zfar,bss
    \ 000000          shadow:     .space  0x800
0035                  static uint8_t dirty[RING];
    \ 000000                      .section zfar,bss
    \ 000000          dirty:      .space  32
0036                  static uint8_t top, row, col, vofs_dirty;
    \ 000000                      .section zfar,bss
    \ 000000          top:        .space  1
    \ 000000                      .section zfar,bss
    \ 000000          row:        .space  1
    \ 000000                      .section zfar,bss
    \ 000000          col:        .space  1
    \ 000000                      .section zfar,bss
    \ 000000          vofs_dirty: .space  1
