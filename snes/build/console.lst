0001                  /* Text console: 32 cols x 28 rows, 8px font, hardware-scroll ring.
0002                   * Own module — the keyboard/ and basic-rom/ projects stay untouched.
0003                   *
0004                   * Mode 1, BG1 4bpp, 256px wide = 32 columns of 8x8 chars. A 32x32 tilemap is
0005                   * one VRAM screen block, so row r lives linearly at MAP_VRAM + r*32 (no
0006                   * two-block split). The 32-row map is used as a ring: scrolling bumps BG1VOFS
0007                   * by 8 and clears the wrapped row, so a scroll dirties one row, not 28.
0008                   *
0009                   * (The PLAN's preferred 64-col Mode 5 needs a BG1+BG2 hires pair — Mode 5
0010                   * feeds even screen dots from the main screen and odd dots from the sub, so a
0011                   * single BG shows only half of each glyph. That's a documented polish step;
0012                   * emu8086/snes/dosboot.asm has the proven two-layer technique to crib.)
0013                   *
0014                   * VRAM: font tiles at word $0000 (tile# == ASCII, 4bpp, plane0 only), tilemap
0015                   * at word $4000. VRAM writes happen only in vblank (con_flush waits for it).
0016                   */
0017                  #include <stdint.h>
0018                  #include "console.h"
0019                  #include "font8x8_basic.h"
0020
