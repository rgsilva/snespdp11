    \ 000000 d4..                 pei     dp:.tiny (_Dp+8)
    \ 000002 d4..                 pei     dp:.tiny (_Dp+10)
    \ 000004 5a                   phy
    \ 000005 5a                   phy
    \ 000006 5a                   phy
    \ 000007 5a                   phy
0024                      if (fast_step() == ST_FALLBACK) c_step();   /* c_step bumps cpu.icount */
    \ 000008 22......             jsl     long:fast_step
    \ 00000c c9ffff               cmp     ##-1
    \ 00000f d006                 bne     `?L4`
    \ 000011 22......             jsl     long:c_step
    \ 000015 8047                 bra     `?L5`
    \ 000017          `?L4`:
0025                      else cpu.icount++;                          /* asm handled it: count here */
    \ 000017 3b                   tsc
    \ 000018 1a                   inc     a
    \ 000019 a20000               ldx     ##0
    \ 00001c 86..                 stx     dp:.tiny (_Dp+2)
    \ 00001e 85..                 sta     dp:.tiny _Dp
    \ 000020 a9....               lda     ##.word0 (cpu+76)
    \ 000023 85..                 sta     dp:.tiny (_Dp+4)
    \ 000025 a9....               lda     ##.word2 (cpu+76)
    \ 000028 85..                 sta     dp:.tiny (_Dp+6)
    \ 00002a a9....               lda     ##.word0 _Const_0000000000000001
    \ 00002d 85..                 sta     dp:.tiny (_Dp+8)
    \ 00002f a9....               lda     ##.word2 _Const_0000000000000001
    \ 000032 85..                 sta     dp:.tiny (_Dp+10)
    \ 000034 a20300               ldx     ##3
    \ 000037 a00000               ldy     ##0
    \ 00003a 18                   clc
    \ 00003b          `?L12`:
    \ 00003b b7..                 lda     [.tiny (_Dp+4)],y
    \ 00003d 77..                 adc     [.tiny (_Dp+8)],y
    \ 00003f 97..                 sta     [.tiny _Dp],y
    \ 000041 c8                   iny
    \ 000042 c8                   iny
    \ 000043 ca                   dex
    \ 000044 10f5                 bpl     `?L12`
