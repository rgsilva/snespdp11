0001                  /* M4 asm core glue. cpu_step() runs the hand-asm interpreter (fastcore.s) for
0002                   * the opcodes it implements and falls back to the proven C core (c_step) for
0003                   * everything else. Because unhandled instructions fall back, the 68-check
0004                   * suite stays green while the asm core grows opcode-group by opcode-group.
0005                   *
0006                   *   fast_step() returns 0 when it fully executed the instruction, or
0007                   *   ST_FALLBACK (0xFFFF) when it declined: MMU on, PC odd / in the I/O
0008                   *   region, or an opcode it does not yet handle. On fallback the C register
0009                   *   globals (R[], PS, SR0) are left untouched, so c_step re-runs the
0010                   *   instruction from clean state.
0011                   */
0012                  #include <stdint.h>
0013                  #include "pdp11.h"
0014
0015                  #define ST_FALLBACK 0xFFFFu
0016                  extern uint16_t fast_step(void);
0017
0018                  /* The asm core's PDP-11 register file, used as its direct page (D -> fastregs).
0019                   * Bank-0 near RAM (own linker section). Layout mirrors fastcore.s:
0020                   *   $00..$0E R0..R7  $10 PS  then $14.. decode/EA/pointer scratch. */
0021                  uint16_t fastregs[32] __attribute__((section("fastregs")));
    \ 000000                      .section fastregs,bss
    \ 000000                      .public fastregs
    \ 000000          fastregs:   .space  64
0022
0023                  void cpu_step(void) {
